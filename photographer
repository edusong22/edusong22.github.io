<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>사진작가 포트폴리오 학습지</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700&family=Space+Mono:wght@400;700&family=Noto+Sans+KR:wght@400;500;700&display=swap');

  :root{
    --paper:#f5f2ec;
    --ink:#201c18;
    --ink-soft:#565049;
    --rule:#c9c1b4;
    --safelight:#a53a2c;
    --safelight-deep:#7c2a20;
    --frame:#201c18;
  }

  *{ box-sizing:border-box; }

  body{
    margin:0;
    background:#d9d3c6;
    font-family:'Noto Sans KR', sans-serif;
    color:var(--ink);
    display:flex;
    justify-content:center;
    padding:32px 12px 80px;
  }

  input, textarea{
    font-family:inherit;
    color:var(--ink);
  }
  input:focus, textarea:focus{
    outline:none;
  }

  .submit-wrap{
    display:flex;
    justify-content:center;
    padding:30px 0 42px;
  }
  .save-btn{
    font-family:'Space Mono', monospace;
    font-size:13.5px;
    font-weight:700;
    letter-spacing:0.03em;
    color:var(--paper);
    background:var(--safelight);
    border:none;
    padding:15px 30px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:10px;
    box-shadow:0 3px 10px rgba(0,0,0,0.22);
    transition:background 0.15s ease, transform 0.1s ease;
  }
  .save-btn:hover{ background:var(--safelight-deep); }
  .save-btn:active{ transform:translateY(1px); }
  .save-btn svg{ width:16px; height:16px; flex:none; }

  .sheet{
    width:100%;
    max-width:860px;
    background:var(--paper);
    box-shadow:0 2px 24px rgba(0,0,0,0.18);
    position:relative;
    overflow:hidden;
  }

  .sprockets{
    height:22px;
    background:var(--frame);
    display:flex;
    align-items:center;
    gap:14px;
    padding:0 18px;
  }
  .sprockets span{
    width:9px;
    height:9px;
    border-radius:2px;
    background:var(--paper);
    flex:none;
  }
  .sprockets.repeat{
    justify-content:space-between;
  }

  .content{
    padding:44px 48px 20px;
  }

  header.title-block{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    border-bottom:3px solid var(--ink);
    padding-bottom:18px;
    margin-bottom:8px;
    gap:20px;
  }

  .title-block h1{
    font-family:'Noto Serif KR', serif;
    font-weight:700;
    font-size:30px;
    line-height:1.3;
    margin:0;
    letter-spacing:-0.01em;
  }
  .title-block h1 small{
    display:block;
    font-family:'Space Mono', monospace;
    font-size:12px;
    color:var(--safelight);
    font-weight:700;
    letter-spacing:0.04em;
    margin-bottom:6px;
  }

  .id-fields{
    font-family:'Space Mono', monospace;
    font-size:13px;
    text-align:right;
    color:var(--ink-soft);
    white-space:nowrap;
  }
  .id-fields .row{
    display:flex;
    align-items:baseline;
    justify-content:flex-end;
    gap:8px;
    margin-bottom:8px;
  }
  .id-fields .row:last-child{ margin-bottom:0; }
  .id-fields label{ flex:none; }
  .id-fields input{
    width:130px;
    border:none;
    border-bottom:1.4px solid var(--ink);
    height:20px;
    background:transparent;
    font-size:13px;
    text-align:right;
  }
  .id-fields input:focus{ border-bottom-color:var(--safelight); }

  .session-tag{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-family:'Space Mono', monospace;
    font-size:12px;
    font-weight:700;
    color:var(--paper);
    background:var(--ink);
    padding:5px 12px 5px 10px;
    margin:30px 0 4px;
    letter-spacing:0.03em;
  }
  .session-tag::before{
    content:'●';
    color:var(--safelight);
    font-size:10px;
  }

  .session-heading{
    font-family:'Noto Serif KR', serif;
    font-size:22px;
    font-weight:700;
    margin:2px 0 22px;
    padding-bottom:10px;
    border-bottom:1.5px solid var(--rule);
  }

  section.block{
    margin-bottom:30px;
  }

  .q-num{
    font-family:'Space Mono', monospace;
    color:var(--safelight);
    font-weight:700;
    margin-right:6px;
  }

  h3.q{
    font-family:'Noto Serif KR', serif;
    font-size:16.5px;
    font-weight:600;
    margin:0 0 14px;
  }

  .field-row{
    display:flex;
    flex-wrap:wrap;
    gap:22px 30px;
    margin-bottom:6px;
  }
  .field{
    display:flex;
    align-items:baseline;
    gap:8px;
    flex:1 1 220px;
  }
  .field label{
    font-family:'Space Mono', monospace;
    font-size:12.5px;
    color:var(--ink-soft);
    white-space:nowrap;
    flex:none;
  }
  .field input{
    flex:1;
    border:none;
    border-bottom:1.4px solid var(--ink);
    height:24px;
    background:transparent;
    font-size:14px;
    padding:0 2px;
  }
  .field input:focus{ border-bottom-color:var(--safelight); }

  .label-hint{
    font-size:13.5px;
    color:var(--ink-soft);
    margin:0 0 8px;
  }

  .lines-textarea{
    display:block;
    width:100%;
    border:none;
    background-color:transparent;
    background-image:repeating-linear-gradient(
      to bottom,
      transparent, transparent 29px,
      var(--rule) 29px, var(--rule) 30.4px
    );
    line-height:30px;
    font-size:14px;
    padding:0 2px;
    resize:vertical;
  }
  .lines-textarea:focus{
    background-image:repeating-linear-gradient(
      to bottom,
      transparent, transparent 29px,
      var(--safelight) 29px, var(--safelight) 30.4px
    );
  }

  .artist-table{
    width:100%;
    border-collapse:collapse;
    font-size:13.5px;
  }
  .artist-table th, .artist-table td{
    border:1.4px solid var(--rule);
    padding:9px 14px;
    text-align:left;
    vertical-align:top;
  }
  .artist-table th{
    width:110px;
    font-family:'Space Mono', monospace;
    font-size:11.5px;
    font-weight:700;
    color:var(--paper);
    background:var(--ink);
    letter-spacing:0.02em;
  }
  .artist-table td{
    color:var(--ink);
    line-height:1.6;
  }

  .frame-table{
    width:100%;
    border-collapse:collapse;
    margin-top:4px;
    table-layout:fixed;
  }
  .frame-table th, .frame-table td{
    border:1.4px solid var(--ink);
    padding:0;
    vertical-align:top;
    font-size:13.5px;
  }
  .frame-table thead th{
    background:var(--ink);
    color:var(--paper);
    font-family:'Space Mono', monospace;
    font-weight:700;
    font-size:12px;
    letter-spacing:0.02em;
    text-align:left;
    padding:10px 12px;
  }
  .frame-table td.title-cell input{
    width:100%;
    height:100%;
    min-height:64px;
    border:none;
    background:transparent;
    font-size:14px;
    padding:10px 12px;
  }
  .frame-table td.desc-cell textarea{
    width:100%;
    min-height:64px;
    border:none;
    background:transparent;
    font-size:13.5px;
    padding:10px 12px;
    resize:vertical;
    line-height:1.5;
  }

  .photo-cell{
    width:120px;
  }
  .photo-slot{
    position:relative;
    width:100%;
    height:100%;
    min-height:96px;
    background:repeating-linear-gradient(
      45deg, transparent, transparent 6px,
      rgba(165,58,44,0.07) 6px, rgba(165,58,44,0.07) 7px
    );
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    overflow:hidden;
  }
  .photo-slot img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }
  .photo-slot .placeholder{
    text-align:center;
    color:var(--ink-soft);
    font-family:'Space Mono', monospace;
  }
  .photo-slot .placeholder .plus{
    font-size:20px;
    color:var(--safelight);
    display:block;
    line-height:1;
    margin-bottom:4px;
  }
  .photo-slot .placeholder .txt{
    font-size:9.5px;
    letter-spacing:0.02em;
  }
  .photo-slot .frame-num{
    position:absolute;
    top:4px; left:5px;
    font-family:'Space Mono', monospace;
    font-size:10px;
    font-weight:700;
    color:var(--paper);
    background:rgba(32,28,24,0.72);
    padding:1px 5px;
  }
  .photo-slot input[type=file]{
    display:none;
  }

  .note{
    font-size:12px;
    color:var(--ink-soft);
    margin-top:8px;
    font-family:'Space Mono', monospace;
  }

  .keywords{
    display:flex;
    gap:16px;
    flex-wrap:wrap;
  }
  .keyword-slot{
    flex:1 1 180px;
    display:flex;
    align-items:center;
    gap:10px;
    border:1.4px solid var(--ink);
    padding:10px 14px;
  }
  .keyword-slot .num{
    font-family:'Space Mono', monospace;
    font-weight:700;
    color:var(--paper);
    background:var(--safelight);
    width:22px; height:22px;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-size:12px;
    flex:none;
  }
  .keyword-slot input{
    flex:1;
    border:none;
    border-bottom:1.4px solid var(--ink);
    height:20px;
    background:transparent;
    font-size:14px;
    padding:0 2px;
  }
  .keyword-slot input:focus{ border-bottom-color:var(--safelight); }

  .divider{
    height:1px;
    background:var(--rule);
    margin:34px 0 26px;
    position:relative;
  }
  .divider::after{
    content:'✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -';
    position:absolute;
    top:-9px;
    left:0;
    font-size:11px;
    color:var(--rule);
    letter-spacing:1px;
    background:var(--paper);
    padding-right:6px;
  }

  footer.sheet-footer{
    text-align:center;
    font-family:'Space Mono', monospace;
    font-size:10.5px;
    color:var(--ink-soft);
    padding:18px 0 28px;
    letter-spacing:0.04em;
  }

  @media print{
    body{ background:#fff; padding:0; }
    .sheet{ box-shadow:none; max-width:100%; }
    .submit-wrap{ display:none; }
    section.block{ break-inside: avoid; }
    .frame-table{ break-inside: avoid; }
    input, textarea{ background:transparent !important; }
  }

  @media (max-width:600px){
    .content{ padding:28px 20px 10px; }
    header.title-block{ flex-direction:column; align-items:flex-start; }
    .id-fields{ text-align:left; }
    .id-fields .row{ justify-content:flex-start; }
    .id-fields input{ text-align:left; }
    .title-block h1{ font-size:24px; }
  }
</style>
</head>
<body>

<div class="sheet">

  <div class="sprockets repeat">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="content">

    <header class="title-block">
      <h1><small>PHOTOGRAPHY STUDIES WORKSHEET</small>사진작가 포트폴리오</h1>
      <div class="id-fields">
        <div class="row"><label>학번</label><input type="text"></div>
        <div class="row"><label>이름</label><input type="text"></div>
      </div>
    </header>

    <!-- 1차시 -->
    <div class="session-tag">1차시 · SESSION 01</div>
    <h2 class="session-heading">사진작가 알아보기</h2>

    <section class="block">
      <h3 class="q">추천 작가 목록</h3>
      <p class="label-hint" style="margin-bottom:14px;">아래 목록 중 관심 있는 작가를 골라 조사해 보세요. (목록 외 작가도 선택 가능)</p>
      <table class="artist-table">
        <tbody>
          <tr><th>인물·초상</th><td>애니 레보비츠, 리처드 아베돈, 어빙 펜</td></tr>
          <tr><th>다큐멘터리·보도</th><td>도로시아 랭, 로버트 카파, 스티브 맥커리</td></tr>
          <tr><th>스트리트</th><td>앙리 카르티에 브레송, 비비안 마이어, 다이앤 아버스</td></tr>
          <tr><th>도시·건축</th><td>안드레아스 거스키, 베른트&힐라 베허, 줄리어스 슐만</td></tr>
          <tr><th>풍경·자연</th><td>안셀 애덤스, 세바스치앙 살가두, 프란스 랜팅</td></tr>
          <tr><th>패션</th><td>헬무트 뉴튼, 마리오 테스티노</td></tr>
          <tr><th>한국 작가</th><td>구본창, 배병우, 김아타</td></tr>
        </tbody>
      </table>
    </section>

    <section class="block">
      <h3 class="q"><span class="q-num">1</span>내가 선택한 작가</h3>
      <div class="field-row">
        <div class="field"><label>작가명</label><input type="text"></div>
        <div class="field"><label>활동 시기</label><input type="text"></div>
      </div>
      <div class="field-row">
        <div class="field"><label>활동 국가</label><input type="text"></div>
        <div class="field"><label>주요 분야</label><input type="text"></div>
      </div>
      <p class="label-hint" style="margin-top:20px;">이 작가를 선택한 이유</p>
      <textarea class="lines-textarea" rows="2"></textarea>
    </section>

    <section class="block">
      <h3 class="q"><span class="q-num">2</span>대표 작품 3점</h3>
      <table class="frame-table">
        <thead>
          <tr><th class="photo-cell">사진</th><th>작품명</th><th>내가 주목한 부분</th></tr>
        </thead>
        <tbody id="frame-body"></tbody>
      </table>
      <p class="note">※ 사진 칸을 클릭해 대표 작품 사진을 업로드하세요.</p>
    </section>

    <div class="divider"></div>

    <!-- 2차시 -->
    <div class="session-tag">2차시 · SESSION 02</div>
    <h2 class="session-heading">작가의 사진 분석하기</h2>

    <section class="block">
      <h3 class="q"><span class="q-num">3</span>이 작가의 사진에서 발견한 특징</h3>
      <p class="label-hint">주로 무엇을 찍었나요?</p>
      <textarea class="lines-textarea" rows="1"></textarea>
      <p class="label-hint" style="margin-top:20px;">사진의 분위기나 느낌은?</p>
      <textarea class="lines-textarea" rows="1"></textarea>
      <p class="label-hint" style="margin-top:20px;">구도·빛·색·촬영 방법 등에서 발견한 특징은?</p>
      <textarea class="lines-textarea" rows="2"></textarea>
    </section>

    <section class="block">
      <h3 class="q"><span class="q-num">4</span>작가의 사진을 3개의 키워드로 표현한다면?</h3>
      <div class="keywords">
        <div class="keyword-slot"><span class="num">1</span><input type="text"></div>
        <div class="keyword-slot"><span class="num">2</span><input type="text"></div>
        <div class="keyword-slot"><span class="num">3</span><input type="text"></div>
      </div>
    </section>

    <section class="block">
      <h3 class="q"><span class="q-num">5</span>내가 가장 인상 깊었던 사진</h3>
      <div class="field-row">
        <div class="field"><label>작품명</label><input type="text"></div>
      </div>
      <p class="label-hint" style="margin-top:18px;">이 사진이 인상 깊었던 이유</p>
      <textarea class="lines-textarea" rows="2"></textarea>
    </section>

    <section class="block">
      <h3 class="q"><span class="q-num">6</span>나의 사진 활동과 연결하기</h3>
      <p class="label-hint">이 작가에게서 내가 배우고 싶은 점은?</p>
      <textarea class="lines-textarea" rows="2"></textarea>
      <p class="label-hint" style="margin-top:20px;">내가 직접 찍어 보고 싶은 사진은?</p>
      <textarea class="lines-textarea" rows="2"></textarea>
    </section>

    <div class="submit-wrap">
      <button class="save-btn" onclick="window.print()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
        완성한 활동지 PDF로 제출하기
      </button>
    </div>

    <footer class="sheet-footer">GEOGRAPHY / PHOTOGRAPHY ACTIVITY — HANDOUT No. 01</footer>
  </div>

  <div class="sprockets repeat">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

</div>

<script>
  const frameBody = document.getElementById('frame-body');
  for (let i = 1; i <= 3; i++) {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="photo-cell">
        <label class="photo-slot">
          <span class="frame-num">FRAME ${String(i).padStart(2,'0')}</span>
          <span class="placeholder">
            <span class="plus">+</span>
            <span class="txt">사진 추가</span>
          </span>
          <input type="file" accept="image/*">
        </label>
      </td>
      <td class="title-cell"><input type="text" placeholder=""></td>
      <td class="desc-cell"><textarea rows="3"></textarea></td>
    `;
    frameBody.appendChild(tr);

    const slot = tr.querySelector('.photo-slot');
    const fileInput = tr.querySelector('input[type=file]');
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        slot.innerHTML = `<span class="frame-num">FRAME ${String(i).padStart(2,'0')}</span><img src="${ev.target.result}" alt="작품 ${i}">`;
        slot.appendChild(fileInput);
      };
      reader.readAsDataURL(file);
    });
  }

  // textarea 자동 높이 조절 (여러 줄 입력 시 확장)
  document.querySelectorAll('textarea').forEach(ta => {
    ta.addEventListener('input', function(){
      this.style.height = 'auto';
      this.style.height = Math.max(this.scrollHeight, this.offsetHeight) + 'px';
    });
  });
</script>

</body>
</html>
